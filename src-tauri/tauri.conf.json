{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex AutoResume",
  "version": "0.1.0",
  "identifier": "io.codex-autoresume.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Codex AutoResume", "width": 760, "height": 580, "minWidth": 560, "minHeight": 440 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Codex 本地任务续跑助手（开发预览）",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "11.0" },
    "windows": { "nsis": { "displayLanguageSelector": true, "languages": ["SimpChinese", "English"] } }
  }
}
