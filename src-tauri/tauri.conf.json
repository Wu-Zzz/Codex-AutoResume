{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex AutoResume",
  "version": "0.2.0-alpha.1",
  "identifier": "io.codex-autoresume.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Codex AutoResume",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 520,
        "theme": "Dark",
        "backgroundColor": "#0B0F17"
      },
      {
        "label": "tray",
        "title": "Codex AutoResume",
        "url": "index.html?view=tray",
        "width": 380,
        "height": 560,
        "visible": false,
        "focus": false,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "theme": "Dark",
        "backgroundColor": "#0B0F17"
      }
    ],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Codex 本地任务续跑助手（开发预览）",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "11.0" },
    "windows": { "nsis": { "displayLanguageSelector": true, "languages": ["SimpChinese", "English"] } }
  }
}
