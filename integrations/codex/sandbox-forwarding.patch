+// Modified by Codex AutoResume on 2026-10-21: preserve the official sandbox helper.
+use std::ffi::OsStr;
+use std::io;
+
+/// The standalone server advertises itself as the MCP sandbox launcher. Forward
+/// only that subcommand to the verified official CLI; normal App Server and
+/// arg0 helper dispatch continue to use this modified executable.
+pub(crate) fn forward_if_sandbox() -> io::Result<()> {
+    let args: Vec<_> = std::env::args_os().skip(1).collect();
+    if args.first().map(|arg| arg.as_os_str()) != Some(OsStr::new("sandbox")) {
+        return Ok(());
+    }
+
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::MetadataExt;
+        use std::os::unix::fs::PermissionsExt;
+        use std::os::unix::process::CommandExt;
+        use std::path::PathBuf;
+        use std::process::Command;
+
+        let official = std::env::var_os("AUTORESUME_OFFICIAL_CLI")
+            .map(PathBuf::from)
+            .ok_or_else(|| {
+                io::Error::other("AutoResume sandbox: official CLI is not configured")
+            })?;
+        if !official.is_absolute() {
+            return Err(io::Error::other(
+                "AutoResume sandbox: official CLI path must be absolute",
+            ));
+        }
+        let official = official
+            .canonicalize()
+            .map_err(|_| io::Error::other("AutoResume sandbox: official CLI is unavailable"))?;
+        let metadata = official.metadata()?;
+        if !metadata.is_file() || metadata.permissions().mode() & 0o111 == 0 {
+            return Err(io::Error::other(
+                "AutoResume sandbox: official CLI must be an executable file",
+            ));
+        }
+        let current = std::env::current_exe()?.metadata()?;
+        if metadata.dev() == current.dev() && metadata.ino() == current.ino() {
+            return Err(io::Error::other(
+                "AutoResume sandbox: refusing recursive CLI forwarding",
+            ));
+        }
+
+        // No shell, argument rewriting, config override, second App Server, or
+        // fallback after execution. exec preserves stdio, cwd, exit and signals.
+        Err(Command::new(official).args(args).exec())
+    }
+
+    #[cfg(not(unix))]
+    Err(io::Error::new(
+        io::ErrorKind::Unsupported,
+        "AutoResume sandbox forwarding is not validated on this platform",
+    ))
+}
