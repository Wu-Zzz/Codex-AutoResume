+        .with_provider_name("OpenAI")
+        .enable_feature(Feature::ContentItemKinds)
+        .with_provider_config("supports_websockets = false")
+        .write(home.path())?;
+    let mut server = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .without_managed_config()
+        .build_initialized()
+        .await?;
