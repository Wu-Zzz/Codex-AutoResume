+/// An internal goal/queue can start after the App Server checked a quota
+/// failure. The final Core admission must reject rather than steer into it.
+#[tokio::test]
+async fn autoresume_continuation_rejects_internal_start_and_completed_successor() {
+    let (session, turn_context, _rx) = make_session_and_context_with_rx().await;
+    session.state.lock().await.last_started_turn_id = Some("quota-failed".to_owned());
+    let settings = session.thread_settings_snapshot().await;
+    session
+        .spawn_task(
+            Arc::clone(&turn_context),
+            Vec::new(),
+            NeverEndingTask {
+                kind: TaskKind::Regular,
+                listen_to_cancellation_token: true,
+            },
+        )
+        .await;
+    session.state.lock().await.last_started_turn_id = Some(turn_context.sub_id.clone());
+    for expected_reason in [NotSubmittedReason::NotIdle, NotSubmittedReason::Superseded] {
+        let history_before = session
+            .clone_history()
+            .await
+            .raw_items()
+            .cloned()
+            .collect::<Vec<_>>();
+        let outcome = handle(
+            &session,
+            TurnInputRequest::new(SubmittedTurnInput::ResponseItem(user_message("continue"))),
+            TurnInputMode::ContinueIfIdle {
+                expected_previous_turn_id: "quota-failed".to_owned(),
+            },
+            "autoresume-attempt".to_owned(),
+        )
+        .await
+        .unwrap();
+        assert_eq!(
+            outcome,
+            TurnInputSubmission::NotSubmitted {
+                reason: expected_reason
+            }
+        );
+        assert_eq!(session.thread_settings_snapshot().await, settings);
+        assert_eq!(
+            session
+                .clone_history()
+                .await
+                .raw_items()
+                .cloned()
+                .collect::<Vec<_>>(),
+            history_before,
+            "rejected continuation must not enter conversation history"
+        );
+        assert!(
+            session
+                .input_queue
+                .get_pending_input(&session.active_turn)
+                .await
+                .0
+                .is_empty(),
+            "rejection must not queue or steer continuation input"
+        );
+        session.abort_all_tasks(TurnAbortReason::Interrupted).await;
+    }
 }
 
